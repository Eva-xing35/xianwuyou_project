.status-card {
  margin-bottom: 24rpx;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.status-desc {
  color: #6b7280;
  font-size: 24rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 24rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  text-align: center;
}

.summary-item .label {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  display: block;
}

.summary-item .value {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
}

.summary-item .earnings {
  color: #16a34a;
}

.order-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.entry-text .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.entry-text .desc {
  color: #6b7280;
  font-size: 24rpx;
}

.order-entry .arrow {
  font-size: 48rpx;
  color: #9ca3af;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.16);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

.modal-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.modal-row .label {
  color: #6b7280;
  font-size: 26rpx;
}

.modal-row .value {
  color: #1f2937;
  font-size: 28rpx;
  margin-left: 16rpx;
  text-align: right;
}

.modal-row .highlight {
  color: #f97316;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.modal-actions .reject {
  flex: 1;
  margin-right: 16rpx;
  background: #f3f4f6;
  color: #6b7280;
}

.modal-actions .accept {
  flex: 1;
  background: #2563eb;
  color: #ffffff;
}

.modal-close {
  margin-top: 16rpx;
  background: transparent;
  color: #9ca3af;
}

.loading-hint {
  text-align: center;
  color: #6b7280;
  margin-top: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.input {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #111827;
}

.error {
  display: block;
  color: #ef4444;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.link-card .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.link-card .desc {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.link-card .arrow {
  font-size: 48rpx;
  color: #9ca3af;
}

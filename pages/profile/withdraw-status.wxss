.progress-item {
  margin-bottom: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #16a34a;
}

.status {
  font-size: 26rpx;
  color: #2563eb;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label {
  color: #6b7280;
  font-size: 24rpx;
}

.value {
  color: #1f2937;
  font-size: 26rpx;
}

.timeline {
  margin-top: 16rpx;
  padding-left: 12rpx;
  border-left: 2rpx solid #e5e7eb;
}

.timeline-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d1d5db;
  margin-right: 12rpx;
  margin-left: -20rpx;
  margin-top: 6rpx;
}

.dot.done {
  background: #2563eb;
}

.timeline-text .title {
  font-size: 26rpx;
  color: #1f2937;
}

.timeline-text .time {
  display: block;
  color: #9ca3af;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.loading {
  text-align: center;
  color: #9ca3af;
  padding: 24rpx 0;
}

.empty {
  text-align: center;
  color: #6b7280;
  margin-top: 120rpx;
}

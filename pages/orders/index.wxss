.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  color: #6b7280;
  font-size: 28rpx;
}

.tab-item.active {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.order-list {
  margin-bottom: 32rpx;
}

.loading-text {
  text-align: center;
  color: #9ca3af;
  padding: 24rpx 0;
}

.empty-state {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 64rpx 24rpx;
  text-align: center;
  color: #6b7280;
}

.empty-state .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.empty-state .desc {
  font-size: 26rpx;
}

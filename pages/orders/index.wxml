<view class="page-container">
  <view class="tabs">
    <block wx:for="{{tabs}}" wx:key="key">
      <view class="tab-item {{activeStatus === item.key ? 'active' : ''}}" data-status="{{item.key}}" bindtap="handleTabChange">
        <text>{{item.text}}</text>
      </view>
    </block>
  </view>

  <view wx:if="{{list.length > 0}}" class="order-list">
    <block wx:for="{{list}}" wx:key="id">
      <order-card order="{{item}}" bind:tap="handleOrderTap" bind:primary="handleAccept" bind:secondary="handleReject" />
    </block>
    <view wx:if="{{loading}}" class="loading-text">Loading?</view>
    <view wx:elif="{{!hasMore}}" class="loading-text">No more orders</view>
  </view>

  <view wx:else class="empty-state">
    <text class="title">No orders yet</text>
    <text class="desc">Try another status or check back soon</text>
  </view>
</view>

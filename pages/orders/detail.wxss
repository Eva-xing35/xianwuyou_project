.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.row .label {
  color: #6b7280;
  font-size: 26rpx;
}

.row .value {
  color: #1f2937;
  font-size: 28rpx;
  max-width: 420rpx;
  text-align: right;
}

.row .highlight {
  color: #16a34a;
  font-weight: 600;
}

.mini-btn {
  margin-left: 16rpx;
  background: #2563eb;
  color: #ffffff;
}

.steps {
  margin-top: 24rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.step-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.step-body .instruction {
  color: #1f2937;
  font-size: 28rpx;
}

.step-body .secondary {
  display: block;
  color: #9ca3af;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.status-line {
  margin-bottom: 24rpx;
}

.actions button + button {
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  color: #6b7280;
  margin-top: 120rpx;
}

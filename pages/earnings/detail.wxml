<view class="page-container" wx:if="{{detail}}">
  <view class="card">
    <view class="section-title">订单概览</view>
    <view class="row">
      <text class="label">订单号</text>
      <text class="value">{{detail.orderId}}</text>
    </view>
    <view class="row">
      <text class="label">乘客</text>
      <text class="value">{{detail.customerName}}</text>
    </view>
    <view class="row">
      <text class="label">订单金额</text>
      <text class="value highlight">￥{{detail.orderAmount}}</text>
    </view>
    <view class="row">
      <text class="label">结算时间</text>
      <text class="value">{{detail.settledAt}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">分成概览</view>
    <view class="row">
      <text class="label">司机收益</text>
      <text class="value">￥{{detail.driverShare}}</text>
    </view>
    <view class="row">
      <text class="label">平台服务费</text>
      <text class="value">￥{{detail.platformFee}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{detail.items.length}}">
    <view class="section-title">分成明细</view>
    <block wx:for="{{detail.items}}" wx:key="name">
      <view class="item-row">
        <view class="item-left">
          <text class="item-title">{{item.name}}</text>
          <text class="item-desc">{{item.description}}</text>
        </view>
        <text class="item-amount">￥{{item.amount}}</text>
      </view>
    </block>
  </view>
</view>

<view wx:else class="empty">正在加载分成数据…</view>

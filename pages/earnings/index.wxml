<view class="page-container">
  <view class="card summary-card">
    <view class="header">
      <text class="title">Today&apos;s Earnings</text>
      <text class="amount">?{{summary.todayIncome}}</text>
    </view>
    <view class="stats">
      <view class="stat-item">
        <text class="label">Completed Rides</text>
        <text class="value">{{summary.todayOrders}}</text>
      </view>
      <view class="stat-item">
        <text class="label">Pending Settlement</text>
        <text class="value">?{{summary.pendingWithdraw}}</text>
      </view>
      <view class="stat-item">
        <text class="label">Last Settlement</text>
        <text class="value">{{summary.lastSettlement}}</text>
      </view>
    </view>
  </view>

  <view class="card action-card" bindtap="goToHistory">
    <view class="text">
      <text class="title">Earnings History</text>
      <text class="desc">Check revenue per trip and settlement status</text>
    </view>
    <text class="arrow">?</text>
  </view>

  <view class="card action-card" bindtap="goToWithdraw">
    <view class="text">
      <text class="title">Withdraw Funds</text>
      <text class="desc">Submit corporate or personal payout request</text>
    </view>
    <text class="arrow">?</text>
  </view>

  <view wx:if="{{loading}}" class="loading">Loading?</view>
</view>

<view class="page-container">
  <view class="card summary-card">
    <view class="header">
      <text class="title">今日收益</text>
      <text class="amount">￥{{summary.todayIncome}}</text>
    </view>
    <view class="stats">
      <view class="stat-item">
        <text class="label">完成订单</text>
        <text class="value">{{summary.todayOrders}}</text>
      </view>
      <view class="stat-item">
        <text class="label">待结算金额</text>
        <text class="value">￥{{summary.pendingWithdraw}}</text>
      </view>
      <view class="stat-item">
        <text class="label">上次结算</text>
        <text class="value">{{summary.lastSettlement}}</text>
      </view>
    </view>
  </view>

  <view class="card action-card" bindtap="goToHistory">
    <view class="text">
      <text class="title">收益记录</text>
      <text class="desc">查看每笔订单分成与结算状态</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="card action-card" bindtap="goToWithdraw">
    <view class="text">
      <text class="title">提现申请</text>
      <text class="desc">提交对公 / 对私账户提现</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
</view>

.summary-card .header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.summary-card .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.summary-card .amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #16a34a;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-item .label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.stat-item .value {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.action-card .text .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.action-card .text .desc {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.action-card .arrow {
  font-size: 48rpx;
  color: #9ca3af;
}

.loading {
  text-align: center;
  color: #6b7280;
  margin-top: 32rpx;
}

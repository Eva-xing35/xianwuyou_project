.type-group {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.type-option {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1f2937;
}

.type-option radio {
  margin-right: 12rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item .label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #111827;
}

.textarea {
  min-height: 160rpx;
}

.error {
  display: block;
  color: #ef4444;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.submit-btn {
  margin-top: 32rpx;
}

.history-item {
  margin-bottom: 24rpx;
}

.history-item .row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-item .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.history-item .amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #16a34a;
}

.history-item .label {
  color: #6b7280;
  font-size: 24rpx;
}

.history-item .status {
  color: #2563eb;
  font-size: 24rpx;
}

.history-item .value {
  color: #1f2937;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  color: #9ca3af;
  padding: 24rpx 0;
}

.empty {
  text-align: center;
  color: #6b7280;
  margin-top: 120rpx;
}

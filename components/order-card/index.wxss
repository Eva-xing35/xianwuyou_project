.order-card {
  margin-bottom: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.order-status {
  font-size: 24rpx;
  color: #2563eb;
}

.order-body {
  margin-bottom: 16rpx;
}

.trip-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.label {
  color: #6b7280;
  font-size: 24rpx;
}

.value {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 500;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fare {
  font-size: 36rpx;
  color: #16a34a;
  font-weight: 600;
}

.actions button {
  margin-left: 16rpx;
}

.actions .primary {
  background: #2563eb;
  color: #ffffff;
}

.actions .secondary {
  border: 1rpx solid #d1d5db;
  color: #6b7280;
}

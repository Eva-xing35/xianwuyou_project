page {
  background: #f5f6fa;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.page-container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.primary-btn {
  background: #2563eb;
  color: #ffffff;
  border-radius: 999rpx;
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
}

.danger-btn {
  background: #ef4444;
  color: #ffffff;
  border-radius: 999rpx;
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
}

.secondary-text {
  color: #6b7280;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
}
